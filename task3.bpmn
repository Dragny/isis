<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Ведение личных дел студентов" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Student" name="Студент / Абитуриент">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveNotice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dean" name="Сотрудник деканата">
        <bpmn:flowNodeRef>Task_CheckDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IS" name="Информационная система">
        <bpmn:flowNodeRef>Task_RegisterFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateFile</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Подача документов">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitDocs" name="Подать пакет документов">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FixDocs" name="Доработать документы">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SubmitApp" name="Подать заявление (справка / академ. отпуск)">
      <bpmn:incoming>Flow_Study</bpmn:incoming>
      <bpmn:outgoing>Flow_App</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CheckDocs" name="Проверить комплектность и подлинность">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Complete" name="Документы полные?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RegisterFile" name="Зарегистрировать дело (присвоить номер)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Reg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_SubmitDocs" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitDocs" targetRef="Task_CheckDocs" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CheckDocs" targetRef="Gateway_Complete" />
    <bpmn:sequenceFlow id="Flow_No" name="Нет" sourceRef="Gateway_Complete" targetRef="Task_FixDocs" />
    <bpmn:sequenceFlow id="Flow_Retry" sourceRef="Task_FixDocs" targetRef="Task_SubmitDocs" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Да" sourceRef="Gateway_Complete" targetRef="Task_CreateFile" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CreateFile" targetRef="Task_RegisterFile" />
    <bpmn:sequenceFlow id="Flow_Reg" sourceRef="Task_RegisterFile" targetRef="Task_SendNotice" />
    <bpmn:sequenceFlow id="Flow_Notice" sourceRef="Task_SendNotice" targetRef="Task_ReceiveNotice" />
    <bpmn:sequenceFlow id="Flow_Study" sourceRef="Task_ReceiveNotice" targetRef="Task_SubmitApp" />
    <bpmn:sequenceFlow id="Flow_App" sourceRef="Task_SubmitApp" targetRef="Task_AddDocs" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_AddDocs" targetRef="Gateway_Status" />
    <bpmn:sequenceFlow id="Flow_Active" name="Обучается" sourceRef="Gateway_Status" targetRef="Task_UpdateFile" />
    <bpmn:sequenceFlow id="Flow_Loop" sourceRef="Task_UpdateFile" targetRef="Gateway_Status" />
    <bpmn:sequenceFlow id="Flow_Exit" name="Отчислен / выпуск" sourceRef="Gateway_Status" targetRef="Task_CloseFile" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CloseFile" targetRef="EndEvent_1" />
    <bpmn:userTask id="Task_CreateFile" name="Создать личное дело">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReceiveNotice" name="Получить уведомление о зачислении">
      <bpmn:incoming>Flow_Notice</bpmn:incoming>
      <bpmn:outgoing>Flow_Study</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SendNotice" name="Отправить уведомление">
      <bpmn:incoming>Flow_Reg</bpmn:incoming>
      <bpmn:outgoing>Flow_Notice</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateFile" name="Обновить данные в личном деле">
      <bpmn:incoming>Flow_Active</bpmn:incoming>
      <bpmn:outgoing>Flow_Loop</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Status" name="Статус студента?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_Active</bpmn:outgoing>
      <bpmn:outgoing>Flow_Exit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CloseFile" name="Закрыть личное дело">
      <bpmn:incoming>Flow_Exit</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AddDocs" name="Внести документ в личное дело">
      <bpmn:incoming>Flow_App</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Личное дело&#10;закрыто">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="2180" height="640" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_IS_di" bpmnElement="Lane_IS" isHorizontal="true">
        <dc:Bounds x="150" y="480" width="2150" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Dean_di" bpmnElement="Lane_Dean" isHorizontal="true">
        <dc:Bounds x="150" y="280" width="2150" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Student_di" bpmnElement="Lane_Student" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="2150" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="200" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="180" y="205" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitDocs_di" bpmnElement="Task_SubmitDocs">
        <dc:Bounds x="290" y="140" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FixDocs_di" bpmnElement="Task_FixDocs">
        <dc:Bounds x="490" y="140" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitApp_di" bpmnElement="Task_SubmitApp">
        <dc:Bounds x="1150" y="140" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckDocs_di" bpmnElement="Task_CheckDocs">
        <dc:Bounds x="290" y="340" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Complete_di" bpmnElement="Gateway_Complete" isMarkerVisible="true">
        <dc:Bounds x="495" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="475" y="415" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegisterFile_di" bpmnElement="Task_RegisterFile">
        <dc:Bounds x="640" y="540" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateFile_di" bpmnElement="Task_CreateFile">
        <dc:Bounds x="640" y="340" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReceiveNotice_di" bpmnElement="Task_ReceiveNotice">
        <dc:Bounds x="880" y="140" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendNotice_di" bpmnElement="Task_SendNotice">
        <dc:Bounds x="880" y="540" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateFile_di" bpmnElement="Task_UpdateFile">
        <dc:Bounds x="1230" y="540" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Status_di" bpmnElement="Gateway_Status" isMarkerVisible="true">
        <dc:Bounds x="1275" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1255" y="331" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CloseFile_di" bpmnElement="Task_CloseFile">
        <dc:Bounds x="1630" y="340" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AddDocs_di" bpmnElement="Task_AddDocs">
        <dc:Bounds x="990" y="340" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1872" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1857" y="326" width="66" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="236" y="180" />
        <di:waypoint x="290" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="360" y="220" />
        <di:waypoint x="360" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="430" y="380" />
        <di:waypoint x="495" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No">
        <di:waypoint x="520" y="355" />
        <di:waypoint x="520" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="290" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Retry_di" bpmnElement="Flow_Retry">
        <di:waypoint x="490" y="180" />
        <di:waypoint x="430" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes">
        <di:waypoint x="545" y="380" />
        <di:waypoint x="640" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="589" y="355" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="710" y="420" />
        <di:waypoint x="710" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reg_di" bpmnElement="Flow_Reg">
        <di:waypoint x="780" y="580" />
        <di:waypoint x="880" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Notice_di" bpmnElement="Flow_Notice">
        <di:waypoint x="950" y="540" />
        <di:waypoint x="950" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Study_di" bpmnElement="Flow_Study">
        <di:waypoint x="1020" y="180" />
        <di:waypoint x="1150" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_App_di" bpmnElement="Flow_App">
        <di:waypoint x="1160" y="220" />
        <di:waypoint x="1060" y="220" />
        <di:waypoint x="1060" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1130" y="380" />
        <di:waypoint x="1275" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Active_di" bpmnElement="Flow_Active">
        <di:waypoint x="1300" y="405" />
        <di:waypoint x="1300" y="540" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1302" y="453" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Loop_di" bpmnElement="Flow_Loop">
        <di:waypoint x="1300" y="540" />
        <di:waypoint x="1300" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Exit_di" bpmnElement="Flow_Exit">
        <di:waypoint x="1325" y="380" />
        <di:waypoint x="1630" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1436" y="348" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1770" y="380" />
        <di:waypoint x="1872" y="380" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
